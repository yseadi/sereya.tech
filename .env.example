# Supabase project (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret. Only on the server (Vercel env vars), never in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The email Yasmim signs up with. That account becomes the owner (Studio access).
OWNER_EMAIL=

# Invite code friends type when they join. Leave empty to let anyone join.
INVITE_CODE=

# Public address of the site, used in password reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
